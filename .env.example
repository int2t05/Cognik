# Cognik 环境变量模板 — 复制为 .env 后修改

# ============================================
# 数据库（PostgreSQL 容器 + Cognik 服务端共用）
# ============================================
POSTGRES_DB=cognik
POSTGRES_USER=cognik
POSTGRES_PASSWORD=cognik_dev

# 服务端连接 PostgreSQL
# 本地开发：localhost；Docker Compose 通过 environment: 自动覆写为 postgres
COGNIK_DATABASE_HOST=127.0.0.1
COGNIK_DATABASE_PORT=5432
COGNIK_DATABASE_USER=cognik
COGNIK_DATABASE_PASSWORD=cognik_dev
COGNIK_DATABASE_DBNAME=cognik
COGNIK_DATABASE_SSLMODE=disable

# ============================================
# 数据根目录（storage/memory/logs/agent.db 均在此下）
# server/ 为运行目录；../.cognik = 项目根目录 .cognik/
# ============================================
COGNIK_DATA_ROOT=../.cognik

# ============================================
# 文件存储（driver: local | minio，默认 local；路径由 COGNIK_DATA_ROOT 派生）
# ============================================
COGNIK_STORAGE_DRIVER=local

# ============================================
# MinIO 对象存储（driver=minio 时需要，docker compose --profile storage 启动）
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
COGNIK_MINIO_ENDPOINT=localhost:9000
COGNIK_MINIO_ACCESS_KEY=minioadmin
COGNIK_MINIO_SECRET_KEY=minioadmin
COGNIK_MINIO_USE_SSL=false

# ============================================
# JWT
# ============================================
COGNIK_JWT_SECRET=change_me_to_random_64_chars
COGNIK_JWT_ACCESS_EXPIRE=2h
COGNIK_JWT_REFRESH_EXPIRE=168h

# ============================================
# 服务基础配置
# ============================================
COGNIK_SERVER_PORT=8080
COGNIK_SERVER_MODE=debug

# ============================================
# LLM（OpenAI-compatible API：llama.cpp / OpenAI / GLM / DeepSeek 等）
# ============================================
COGNIK_LLM_BASE_URL=https://your-llm-endpoint/v1
COGNIK_LLM_API_KEY=your-api-key
COGNIK_LLM_MODEL=glm-5.2
COGNIK_LLM_MAX_TOKENS=1000000

# ============================================
# Embedding（OpenAI-compatible API：/v1/embeddings 端点）
# DashScope text-embedding-v2 输出 1536 维
# ============================================
COGNIK_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
COGNIK_EMBEDDING_API_KEY=your-api-key
COGNIK_EMBEDDING_MODEL=text-embedding-v2
COGNIK_EMBEDDING_DIMENSION=1536

# ============================================
# AI / RAG 管道选项
# ============================================
COGNIK_AI_RAG_ENABLED=true
COGNIK_AI_TOP_K=5
COGNIK_AI_CONFIDENCE_THRESHOLD=0.6
COGNIK_AI_MAX_HISTORY_MESSAGES=10
COGNIK_AI_CHUNK_SIZE=500
COGNIK_AI_CHUNK_OVERLAP=100
# 文档处理失败重试（指数退避：base_delay * 2^count，最多 max_retries 次）
COGNIK_AI_MAX_RETRIES=3
COGNIK_AI_RETRY_BASE_DELAY=30s
# 向量检索调优（ef_search 必须 ≥ top_k；embedding 批大小；查询 embedding 缓存）
COGNIK_AI_EF_SEARCH=100
COGNIK_AI_EMBED_BATCH=20
COGNIK_AI_QUERY_EMBED_CACHE_TTL=10m
COGNIK_AI_QUERY_EMBED_CACHE_MAX=1000
COGNIK_AI_PROCESSOR_WORKERS=5

# ============================================
# 重排序（需先下载模型: cd server && python models/rerank/download.py）
# ============================================
COGNIK_RERANK_ENABLED=true

# ============================================
# 深度搜索工具链（降级链：Exa → Tavily → DuckDuckGo 本地兜底）
# ============================================
COGNIK_SEARCH_EXA_API_KEY=
COGNIK_SEARCH_TAVILY_API_KEY=
COGNIK_SEARCH_FIRECRAWL_API_KEY=

# ============================================
# 文档解析（MinerU 云端高精度，无 API Key 时降级到本地纯 Go 解析）
# ============================================
MINERU_API_KEY=

# ============================================
# CORS — debug 模式自动允许所有 Origin（AllowOriginFunc）
# 生产模式必须在此配置具体域名（逗号分隔）
# ============================================
COGNIK_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# 模型目录（仅 ai-local profile 使用）
# ============================================
LLAMA_MODELS_DIR=./models
