# Cognos 环境变量模板 — 复制为 .env 后修改

# ============================================
# 数据库（PostgreSQL 容器 + Cognos 服务端共用）
# ============================================
POSTGRES_DB=cognos
POSTGRES_USER=cognos
POSTGRES_PASSWORD=cognos_dev

# 服务端连接 PostgreSQL
# 本地开发：localhost；Docker Compose 通过 environment: 自动覆写为 postgres
COGNOS_DATABASE_HOST=127.0.0.1
COGNOS_DATABASE_PORT=5432
COGNOS_DATABASE_USER=cognos
COGNOS_DATABASE_PASSWORD=cognos_dev
COGNOS_DATABASE_DBNAME=cognos
COGNOS_DATABASE_SSLMODE=disable

# ============================================
# 数据根目录（storage/memory/logs/agent.db 均在此下）
# server/ 为运行目录；../.cognos = 项目根目录 .cognos/
# ============================================
COGNOS_DATA_ROOT=../.cognos

# ============================================
# 文件存储（driver: local | minio，默认 local；路径由 COGNOS_DATA_ROOT 派生）
# ============================================
COGNOS_STORAGE_DRIVER=local

# ============================================
# MinIO 对象存储（driver=minio 时需要，docker compose --profile storage 启动）
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
COGNOS_MINIO_ENDPOINT=localhost:9000
COGNOS_MINIO_ACCESS_KEY=minioadmin
COGNOS_MINIO_SECRET_KEY=minioadmin
COGNOS_MINIO_USE_SSL=false

# ============================================
# JWT
# ============================================
COGNOS_JWT_SECRET=change_me_to_random_64_chars
COGNOS_JWT_ACCESS_EXPIRE=2h
COGNOS_JWT_REFRESH_EXPIRE=168h

# ============================================
# 服务基础配置
# ============================================
COGNOS_SERVER_PORT=8080
COGNOS_SERVER_MODE=debug

# ============================================
# LLM（OpenAI-compatible API：llama.cpp / OpenAI / GLM / DeepSeek 等）
# ============================================
COGNOS_LLM_BASE_URL=https://your-llm-endpoint/v1
COGNOS_LLM_API_KEY=your-api-key
COGNOS_LLM_MODEL=glm-5.2
COGNOS_LLM_MAX_TOKENS=1000000

# ============================================
# Embedding（OpenAI-compatible API：/v1/embeddings 端点）
# DashScope text-embedding-v2 输出 1536 维
# ============================================
COGNOS_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
COGNOS_EMBEDDING_API_KEY=your-api-key
COGNOS_EMBEDDING_MODEL=text-embedding-v2
COGNOS_EMBEDDING_DIMENSION=1536

# ============================================
# AI / RAG 管道选项
# ============================================
COGNOS_AI_DEFAULT_TOP_K=5
COGNOS_AI_CONFIDENCE_THRESHOLD=0.6
COGNOS_AI_MAX_HISTORY_MESSAGES=10
COGNOS_AI_RAG_QUERY_REWRITE=true
COGNOS_AI_RAG_MULTI_ROUTE=true
COGNOS_AI_RAG_HYBRID=true
COGNOS_AI_RAG_RERANK=true
COGNOS_AI_PROCESSOR_WORKERS=5

# ============================================
# 重排序（需先下载模型: cd server && python models/rerank/download.py）
# ============================================
COGNOS_RERANK_ENABLED=true

# ============================================
# 深度搜索工具链（降级链：Exa → Tavily → DuckDuckGo 本地兜底）
# ============================================
COGNOS_SEARCH_EXA_API_KEY=
COGNOS_SEARCH_TAVILY_API_KEY=
COGNOS_SEARCH_FIRECRAWL_API_KEY=

# ============================================
# 文档解析（MinerU 云端高精度，无 API Key 时降级到本地纯 Go 解析）
# ============================================
MINERU_API_KEY=

# ============================================
# CORS — debug 模式自动允许所有 Origin（AllowOriginFunc）
# 生产模式必须在此配置具体域名（逗号分隔）
# ============================================
COGNOS_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# 模型目录（仅 ai-local profile 使用）
# ============================================
LLAMA_MODELS_DIR=./models
